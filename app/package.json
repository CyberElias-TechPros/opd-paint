{
  "name": "opudas-paint",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run index:colours && node ../tools/build-sitemap.mjs && tsc -b && vite build && npm run prerender",
    "index:colours": "node --experimental-transform-types --no-warnings --import ./scripts/register.mjs ../tools/build-colour-index.mjs",
    "data:android": "node --experimental-transform-types --no-warnings --import ./scripts/register.mjs ../tools/build-android-data.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "oxlint src",
    "typecheck": "tsc -b",
    "test": "npm run test:unit && npm run test:server",
    "check": "npm run lint && npm test && npm run test:routes && npm run test:browser && npm run build",
    "server": "node ../server/index.mjs",
    "test:routes": "vite build --ssr scripts/smoke.tsx --outDir .smoke --emptyOutDir --logLevel error && node .smoke/smoke.js",
    "test:unit": "npm run test:unit:file -- scripts/calculator.test.ts && npm run test:unit:file -- scripts/mask.test.ts && npm run test:unit:file -- scripts/data.test.ts && npm run test:unit:file -- scripts/advisor.test.ts",
    "test:unit:file": "node --experimental-strip-types --no-warnings --import ./scripts/register.mjs",
    "test:server": "node --test ../server/index.test.mjs ../server/proxy.test.mjs ../server/ops.test.mjs ../server/edge.test.mjs ../server/limits.test.mjs ../server/admin.test.mjs ../server/privacy.test.mjs",
    "prerender": "vite build --ssr scripts/prerender.tsx --outDir .prerender --emptyOutDir --logLevel error && node .prerender/prerender.js",
    "test:browser": "vite build --ssr scripts/browser.test.tsx --outDir .browser --emptyOutDir --logLevel error && node .browser/browser.test.js",
    "test:a11y": "node scripts/a11y.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "oxlint": "^1.91.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "description": "OPUDA'S PAINT — colour, product and project platform"
}
