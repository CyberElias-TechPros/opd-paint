{
  "name": "opudas-paint",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ../tools/build-sitemap.mjs && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "oxlint src",
    "typecheck": "tsc -b",
    "test": "node --experimental-strip-types --no-warnings --import ./scripts/register.mjs scripts/calculator.test.ts && node --experimental-strip-types --no-warnings --import ./scripts/register.mjs scripts/data.test.ts",
    "check": "npm run lint && npm test && npm run test:routes && npm run build",
    "server": "node ../server/index.mjs",
    "test:routes": "vite build --ssr scripts/smoke.tsx --outDir .smoke --emptyOutDir --logLevel error && node .smoke/smoke.js"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "description": "OPUDA'S PAINT — colour, product and project platform"
}
