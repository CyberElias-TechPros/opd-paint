# Configuration.
#
# Copy to .env for docker compose, and never commit the real file.
# Every value here is optional: with none of them set the site works, the
# enquiry form works, and enquiries are stored on disk. What you lose is the
# things that make it a *service* — someone being told a lead arrived, errors
# being visible, the inbox being reachable.

# --- enquiry inbox ----------------------------------------------------------
# Leave the credentials empty to switch the inbox off entirely: /admin answers
# 404 rather than advertising that it exists. Use a long random password — it is
# compared in constant time and lives only in the environment.
#
# One account, the simple case:
OPD_ADMIN_USER=
OPD_ADMIN_PASSWORD=
# viewer reads /admin; exporter may also download the CSV of every customer
# record. A single account defaults to exporter.
OPD_ADMIN_ROLE=exporter

# Several named people, which is what roadmap 17.02.12 asks for: an inbox with
# one shared password cannot say who looked at a customer's phone number.
# Takes precedence over OPD_ADMIN_USER/PASSWORD when set.
#
#   OPD_ADMIN_USERS=[{"user":"ada","password":"…","role":"exporter","totp":"…"},
#                    {"user":"grace","password":"…","role":"viewer"}]
#
# Generate a TOTP secret and the otpauth:// URL to scan with:
#
#   node server/auth.mjs --new-secret "ada"
OPD_ADMIN_USERS=

# Second factor (roadmap 17.01.12). Set for the single-account form, or per user
# inside OPD_ADMIN_USERS. Standard TOTP: any authenticator app, 30-second codes,
# one step of clock skew tolerated, each code usable once.
OPD_ADMIN_TOTP_SECRET=

# Signs the session and unlock cookies. Without it a random secret is generated
# per boot, which signs every session out on every deploy. Set it to something
# long and random, and change it to invalidate every session at once.
OPD_SESSION_SECRET=

# How long a session lasts, in seconds. 60 to 86400; default 3600 (an hour).
# Sessions are stateless, so this is also how long a copied cookie stays usable
# after the person who owned it signed out.
OPD_ADMIN_SESSION_TTL=3600

# Optional. Comma-separated CIDR ranges or single addresses, IPv4 or IPv6, that
# may reach /admin at all (roadmap 17.01.13). Anything else gets a 404 and a line
# in server/data/admin-access.jsonl. An entry that cannot be parsed allows
# nothing, so a typo closes the inbox rather than opening it.
#
#   OPD_ADMIN_ALLOW_CIDR=196.168.0.0/24, 41.58.12.9, 2c0f:ef68::/32
OPD_ADMIN_ALLOW_CIDR=

# Cookies are marked Secure when the request is HTTPS. Set this to force the flag
# even behind a proxy that terminates TLS, which is the usual production shape.
OPD_ADMIN_COOKIE_SECURE=

# --- abuse limits -----------------------------------------------------------
# Where rate-limit counters live. The default is a JSON lines file in
# OPD_DATA_DIR, so a deploy is not a free pass for whoever was being limited and
# two instances share one allowance. `memory` opts out (a container with no
# writable volume, or a deliberately ephemeral deployment).
OPD_RATE_STORE=

# Duplicate suppression (roadmap 14.01.05): an identical enquiry submitted twice
# inside this many minutes comes back with the first one's reference and is not
# stored again. 0 disables it.
OPD_DEDUPE_MINUTES=10

# --- notifications ----------------------------------------------------------
# Nobody being told is the most common way a lead-generation site fails, so set
# at least one channel. Both are optional and both can be on at once.

# Any endpoint that accepts a JSON POST: Slack, Discord, Teams, Zapier, Make.
# Receives { text, record, routing }.
OPD_NOTIFY_WEBHOOK=

# Transactional email via Resend (https://resend.com). All three are needed for
# email to be attempted.
OPD_RESEND_API_KEY=
OPD_NOTIFY_EMAIL=
OPD_NOTIFY_FROM=OPUDA'S PAINT <enquiries@opudapaint.com>
# Where transactional email is posted. Change it only to point at another
# Resend-compatible endpoint (or a local server in a test).
OPD_RESEND_URL=
# Retry delays in milliseconds, comma separated: three attempts by default.
OPD_NOTIFY_RETRY_MS=500,2000

# Consecutive failures before a channel is called down rather than flaky, and
# logged at error level as `notify.channel_down`. Reported by /api/health.
OPD_NOTIFY_DOWN_AFTER=3

# The customer's own acknowledgement (roadmap 14.02.05): their reference, the
# desk it went to, the SLA, and the data-subject route, sent once. Requires the
# Resend variables above. `off` disables it.
OPD_ACK_CUSTOMER=on

# --- error monitoring -------------------------------------------------------
# Browser and server errors are always written to server/data/errors.jsonl.
# Set a Sentry DSN to forward them as well. No SDK is involved.
OPD_SENTRY_DSN=
OPD_ENV=production

# --- logging ----------------------------------------------------------------
# json for a log drain, or leave it unset for readable local output.
OPD_LOG_FORMAT=
# debug | info | warn | error
OPD_LOG_LEVEL=info
# The release name attached to error reports. Vercel sets VERCEL_GIT_COMMIT_SHA,
# which the build turns into a release stamp automatically.
OPD_RELEASE=

# --- service ----------------------------------------------------------------
# The origin allowed to call this API from a browser. Set it only when the site
# and the service are on different origins; the response then carries
# Access-Control-Allow-Origin for exactly this origin. Left empty, the service is
# same-origin only (the one-container deployment in docker-compose.yml).
OPD_ALLOWED_ORIGIN=https://www.opudapaint.com

# How many proxy hops to believe: `true` (or 1) for a single reverse proxy or
# Docker network in front of this service, 2 for a CDN in front of that. Rate
# limits and abuse logs then key on the visitor rather than on the gateway
# address every request arrives from — without it, twelve enquiries in ten
# minutes from a whole city locks out that city.
#
# Entries are counted from the RIGHT of X-Forwarded-For, because the left-hand
# ones came from the client and are trivially invented. Leave this unset on a
# port exposed directly to the internet.
OPD_TRUST_PROXY=true

# Where the colour index lives. Generated into server/colour-index.json by
# tools/build-colour-index.mjs during the build; override only to point at a
# different copy.
OPD_COLOUR_INDEX=

PORT=8787
OPD_DATA_DIR=/srv/opudas/data
# Set this and the service also serves the built site from the same port.
OPD_STATIC_DIR=/srv/opudas/app/dist

# --- retention --------------------------------------------------------------
# These are the two periods the privacy notice publishes, so changing them means
# changing app/src/routes/Legal.tsx as well: they are one promise in two places.
# 0 keeps everything.
#
# Operational logs — delivery receipts, error reports, admin access lines.
OPD_RETENTION_DAYS=30
# Enquiries, and the data-subject requests made about them. 730 days is the
# "24 months" the notice states.
OPD_ENQUIRY_RETENTION_DAYS=730
# Never configurable: the newsletter consent list and the opt-out suppression
# list. A consent record lives until it is withdrawn, and deleting a suppression
# record would silently resurrect an address that asked to be left alone.

# --- backups ----------------------------------------------------------------
OPD_BACKUP_DAYS=30

# --- monitoring -------------------------------------------------------------
# The public origin, used by tools/uptime-check.mjs, tools/smoke-production.mjs
# and the scheduled Uptime workflow (as the OPD_SITE_ORIGIN repository variable).
OPD_SITE_ORIGIN=https://opudapaint.com
# A dead-man's-switch URL (Healthchecks.io, Cronitor, Uptime Kuma). The check
# pings it only when everything passed, so a monitor that stops running is itself
# an alert — without one, a dead cron job looks exactly like a healthy site.
OPD_UPTIME_HEARTBEAT=

# --- Vercel only ------------------------------------------------------------
# Where the /api/* proxy in app/api/[...path].js forwards to: the enquiry service.
# Leave unset on a Vercel deployment that has no backend yet — the form will
# report failure honestly and keep the visitor's answers on their device.
OPD_API_ORIGIN=
