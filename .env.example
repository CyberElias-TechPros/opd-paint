# Configuration.
#
# Copy to .env for docker compose, and never commit the real file.
# Every value here is optional: with none of them set the site works, the
# enquiry form works, and enquiries are stored on disk. What you lose is the
# things that make it a *service* — someone being told a lead arrived, errors
# being visible, the inbox being reachable.

# --- enquiry inbox ----------------------------------------------------------
# Leave both empty to switch the inbox off entirely: /admin answers 404 rather
# than advertising that it exists. Use a long random password — it is compared
# in constant time and lives only in the environment.
OPD_ADMIN_USER=
OPD_ADMIN_PASSWORD=

# --- notifications ----------------------------------------------------------
# Nobody being told is the most common way a lead-generation site fails, so set
# at least one channel. Both are optional and both can be on at once.

# Any endpoint that accepts a JSON POST: Slack, Discord, Teams, Zapier, Make.
# Receives { text, record, routing }.
OPD_NOTIFY_WEBHOOK=

# Transactional email via Resend (https://resend.com). All three are needed for
# email to be attempted.
OPD_RESEND_API_KEY=
OPD_NOTIFY_EMAIL=
OPD_NOTIFY_FROM=OPUDA'S PAINT <enquiries@opudapaint.com>

# --- error monitoring -------------------------------------------------------
# Browser and server errors are always written to server/data/errors.jsonl.
# Set a Sentry DSN to forward them as well. No SDK is involved.
OPD_SENTRY_DSN=
OPD_ENV=production

# --- logging ----------------------------------------------------------------
# json for a log drain, or leave it unset for readable local output.
OPD_LOG_FORMAT=
# debug | info | warn | error
OPD_LOG_LEVEL=info
# The release name attached to error reports. Vercel sets VERCEL_GIT_COMMIT_SHA,
# which the build turns into a release stamp automatically.
OPD_RELEASE=

# --- service ----------------------------------------------------------------
# The origin allowed to call this API from a browser. Set it only when the site
# and the service are on different origins; the response then carries
# Access-Control-Allow-Origin for exactly this origin. Left empty, the service is
# same-origin only (the one-container deployment in docker-compose.yml).
OPD_ALLOWED_ORIGIN=https://www.opudapaint.com

# How many proxy hops to believe: `true` (or 1) for a single reverse proxy or
# Docker network in front of this service, 2 for a CDN in front of that. Rate
# limits and abuse logs then key on the visitor rather than on the gateway
# address every request arrives from — without it, twelve enquiries in ten
# minutes from a whole city locks out that city.
#
# Entries are counted from the RIGHT of X-Forwarded-For, because the left-hand
# ones came from the client and are trivially invented. Leave this unset on a
# port exposed directly to the internet.
OPD_TRUST_PROXY=true

# Where the colour index lives. Generated into server/colour-index.json by
# tools/build-colour-index.mjs during the build; override only to point at a
# different copy.
OPD_COLOUR_INDEX=

PORT=8787
OPD_DATA_DIR=/srv/opudas/data
# Set this and the service also serves the built site from the same port.
OPD_STATIC_DIR=/srv/opudas/app/dist

# --- backups ----------------------------------------------------------------
OPD_BACKUP_DAYS=30

# --- Vercel only ------------------------------------------------------------
# Where the /api/* proxy in app/api/[...path].js forwards to: the enquiry service.
# Leave unset on a Vercel deployment that has no backend yet — the form will
# report failure honestly and keep the visitor's answers on their device.
OPD_API_ORIGIN=
