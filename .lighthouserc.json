{
  "$schema": "https://raw.githubusercontent.com/GoogleChrome/lighthouse-ci/main/docs/configuration.md",
  "ci": {
    "collect": {
      "startServerCommand": "OPD_STATIC_DIR=app/dist OPD_LOG_LEVEL=warn PORT=8788 node server/index.mjs",
      "startServerReadyPattern": "service.started",
      "startServerReadyTimeout": 20000,
      "url": [
        "http://127.0.0.1:8788/",
        "http://127.0.0.1:8788/colours",
        "http://127.0.0.1:8788/colours/bonny-haze",
        "http://127.0.0.1:8788/calculator",
        "http://127.0.0.1:8788/quote"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "skipAudits": [
          "is-on-https",
          "redirects-http",
          "uses-http2",
          "canonical",
          "uses-long-cache-ttl"
        ],
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 300
          }
        ],
        "first-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 1800
          }
        ],
        "speed-index": [
          "warn",
          {
            "maxNumericValue": 3400
          }
        ],
        "resource-summary:script:size": [
          "warn",
          {
            "maxNumericValue": 500000
          }
        ],
        "resource-summary:stylesheet:size": [
          "warn",
          {
            "maxNumericValue": 160000
          }
        ],
        "resource-summary:image:size": [
          "warn",
          {
            "maxNumericValue": 1200000
          }
        ],
        "resource-summary:font:size": [
          "warn",
          {
            "maxNumericValue": 240000
          }
        ],
        "resource-summary:total:size": [
          "warn",
          {
            "maxNumericValue": 2200000
          }
        ],
        "uses-responsive-images": "warn",
        "offscreen-images": "warn",
        "unused-javascript": "warn",
        "color-contrast": "error",
        "heading-order": "error",
        "link-name": "error",
        "button-name": "error",
        "image-alt": "error",
        "html-has-lang": "error",
        "document-title": "error",
        "meta-description": "error"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse-reports",
      "reportFilenamePattern": "%%PATHNAME%%-%%DATETIME%%.report.%%EXTENSION%%"
    }
  }
}
