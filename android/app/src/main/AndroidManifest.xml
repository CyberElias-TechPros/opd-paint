<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      INTERNET and ACCESS_NETWORK_STATE are what "offline-first with sync"
      actually means on a phone: the app writes locally and needs to know when
      there is a route out. WorkManager's network constraint reads the second.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Location is for the dealer locator, and it is optional in every sense: the
      permission is requested only when the visitor asks for dealers near them,
      the locator works from a chosen city without it, and both features below are
      declared not required so the app is installable on a device with no GPS.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
      Android 13 made notifications a runtime permission. The app asks only when
      there is something worth saying — an enquiry that queued offline has
      reached the desk, or a delivery failed and needs a person.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!--
      Package visibility (Android 11+). Every journey in this app ends in a phone
      call, a WhatsApp message, a dealer visit or a quote, and resolving those
      intents fails silently without declaring them — which looks like "the
      button does nothing" on the one screen that matters most.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <!--
          The room preview shares a PNG. Declaring only text/plain above leaves the
          image chooser empty on Android 11 and newer, which reads to the customer as
          "this phone has no apps" rather than "the manifest is one line short".
        -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="image/png" />
        </intent>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <application
        android:name=".OpudasPaintApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpudasPaint"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.OpudasPaint"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              A shared project link opens the app on the board it describes. The
              web version carries the state in the URL (/project?s=<token>); the
              app accepts the same token so one link works in both, which is the
              only reason the share codec has to stay byte-compatible across two
              platforms.
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="opudapaint.com" android:pathPrefix="/project" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <!--
          Sharing a preview with another app.

          A content:// URI from this provider rather than a file:// path, because
          handing another app a file URI throws FileUriExposedException on API 24 and
          above - every device this app supports. The provider is not exported: nothing
          can ask it for a file, and a URI it has granted is readable only by the app it
          was granted to, only for as long as that grant lives.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/preview_paths" />
        </provider>

    </application>
</manifest>
