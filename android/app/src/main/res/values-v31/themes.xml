<?xml version="1.0" encoding="utf-8"?>
<!--
  The Android 12+ splash screen is generated from these attributes. Without them
  the system splashes the launcher icon on a white field, which reads as a
  different app for the half second before the first frame.
-->
<resources>
    <style name="Theme.OpudasPaint" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/paper</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/paper</item>
    </style>
</resources>
